# Buildroot checkout (fetched by build_os.sh)
/buildroot/
buildroot-*/

# Build output and download cache
/output/
/dl/

# Build artifacts (images, update bundles, checksums)
*.img
*.raucb
*.raucb.sha256
*.ext4
*.part

# Python bytecode from local linting/tests
__pycache__/
*.pyc
*.pyo

# Test and coverage droppings
.pytest_cache/
.coverage
tests/artifacts/

# RAUC signing pair handed to the build jobs by CI
/rauc-keys/

# Local overrides
*.local
.env
