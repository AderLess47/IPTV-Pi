#!/bin/sh
#
# IPTV-Pi: import Wi-Fi credentials from the FAT boot partition.
#
# Put a file called wifi.txt in the root of the boot partition (the one you
# see when the SD card is plugged into a computer):
#
#     ssid=MyNetwork
#     psk=MyPassword
#     country=DE
#
# or simply the SSID on the first line and the password on the second.
# The credentials are written to /etc/wpa_supplicant/wpa_supplicant-wlan0.conf
# and the file is renamed to wifi.txt.applied so it is not imported again.
#
# Note: the boot partition is FAT and not encrypted - delete wifi.txt once
# the box is on the network if that matters to you.

set -u

BOOT_FILE="${IPTV_WIFI_FILE:-/boot/wifi.txt}"
CONF="${IPTV_WPA_CONF:-/etc/wpa_supplicant/wpa_supplicant-wlan0.conf}"
COUNTRY_DEFAULT="${IPTV_WIFI_COUNTRY:-00}"

[ -f "${BOOT_FILE}" ] || exit 0

log() { logger -t iptv-wifi "$*" 2>/dev/null || true; }

ssid=""
psk=""
country=""

while IFS= read -r raw || [ -n "${raw}" ]; do
	line="$(printf '%s' "${raw}" | tr -d '\r')"
	# strip leading/trailing whitespace
	line="$(printf '%s' "${line}" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
	case "${line}" in
		''|\#*) continue ;;
	esac

	if [ "${line%%=*}" != "${line}" ]; then
		key="$(printf '%s' "${line%%=*}" | tr 'A-Z' 'a-z')"
		value="$(printf '%s' "${line#*=}" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//' -e 's/^"//' -e 's/"$//')"
		case "${key}" in
			ssid) ssid="${value}" ;;
			psk|password|passphrase) psk="${value}" ;;
			country) country="${value}" ;;
		esac
	else
		# Two-line format: SSID then password.
		if [ -z "${ssid}" ]; then
			ssid="${line}"
		elif [ -z "${psk}" ]; then
			psk="${line}"
		fi
	fi
done < "${BOOT_FILE}"

if [ -z "${ssid}" ] || [ -z "${psk}" ]; then
	log "wifi.txt ignored: both SSID and password are required"
	exit 0
fi

[ -n "${country}" ] || country="${COUNTRY_DEFAULT}"

# Escape backslashes and double quotes for wpa_supplicant's quoted strings.
escape() {
	printf '%s' "$1" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g'
}

tmp="${CONF}.tmp.$$"
mkdir -p "$(dirname "${CONF}")"
umask 077
cat > "${tmp}" <<EOF
# Generated by iptv-wifi-import from /boot/wifi.txt
# Edit /boot/wifi.txt on the SD card instead of editing this file, or delete
# both and write the configuration by hand.

country=${country}

network={
	ssid="$(escape "${ssid}")"
	psk="$(escape "${psk}")"
	key_mgmt=WPA-PSK
}
EOF

# Nothing changed? Then do not bounce the interface.
if [ -f "${CONF}" ] && cmp -s "${tmp}" "${CONF}"; then
	rm -f "${tmp}"
	log "wifi.txt matches the current configuration, not restarting wpa_supplicant"
else
	mv -f "${tmp}" "${CONF}"
	chmod 0600 "${CONF}"
	log "Wi-Fi configuration written for SSID '${ssid}'"
	# Only relevant when a wireless interface exists (BindsTo= on the unit).
	systemctl restart wpa_supplicant-wlan0 >/dev/null 2>&1 || true
fi

# Mark the file as consumed so a reboot does not repeat the import. /boot is
# mounted read-only, so the rename gets a short read-write window that is closed
# again on exit (with a sync in between).
BOOT_FS="$(dirname "${BOOT_FILE}")"
if mount -o remount,rw "${BOOT_FS}" >/dev/null 2>&1; then
	trap 'sync; mount -o remount,ro "${BOOT_FS}" >/dev/null 2>&1 || true' EXIT
fi
mv -f "${BOOT_FILE}" "${BOOT_FILE}.applied" 2>/dev/null || true
sync
