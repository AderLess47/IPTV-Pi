[Unit]
Description=Set the CPU frequency governor to ondemand
Documentation=file:/usr/bin/iptv-cpufreq-setup
After=sysinit.target
ConditionPathExists=/sys/devices/system/cpu/cpu0/cpufreq/scaling_governor

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/bin/iptv-cpufreq-setup

[Install]
WantedBy=multi-user.target
